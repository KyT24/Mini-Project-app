# Salin file ini menjadi .env lalu isi nilainya: cp example.env .env

# URL dasar API backend (Mini-Project.api), termasuk API_PREFIX.
# Default bila kosong: http://localhost:8000/api/v1 (src/config/axiosInstance.ts)
# Prefix NEXT_PUBLIC_ membuat nilai ini terbaca di browser, jadi jangan isi rahasia di sini.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
