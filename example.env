# Salin file ini menjadi .env.local: cp example.env .env.local

# 1. Konfigurasi Supabase Project (Database, Auth, Storage, Realtime - lihat panduan di INT.md)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 2. Konfigurasi Backend REST API Gateway (Express.js service pada port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

